{
  "info": {
    "name": "DeadLink Watchdog API",
    "description": "Complete API collection for DeadLink Watchdog - Nigerian Website Link Monitor.\n\n🚀 QUICK START:\n1. Import this collection + environment\n2. Run 'Register User' to create account\n3. Run 'Login User' to get access token (auto-saved)\n4. All other requests will use the saved token automatically\n\n📝 NOTE: Auth endpoints (register/login/forgot/reset) don't need tokens. All other endpoints inherit collection-level Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "websiteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "crawlResultId",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ],
