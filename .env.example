# Server Configuration
PORT=3000
PUPPETEER_EXECUTABLE_PATH=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
NODE_ENV=development

# Database Configuration (local PostgreSQL)
# Prisma uses DATABASE_URL. Keep DB_* for reference/scripts if needed.
DATABASE_URL=postgresql://postgres:password@localhost:5432/deadlink_watchdog_dev?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deadlink_watchdog_dev
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_VERIFICATION_TEMPLATE_ID=1
BREVO_PASSWORD_RESET_TEMPLATE_ID=2
BREVO_CRAWL_NOTIFICATION_TEMPLATE_ID=3
FROM_EMAIL=noreply@deadlinkwatchdog.com
FROM_NAME=DeadLink Watchdog
FRONTEND_URL=http://localhost:3000

# Webhook Testing (Optional)
WEBHOOK_TEST_URL=https://webhook.site/unique-id

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Crawler Configuration
CRAWLER_DELAY=1000
CRAWLER_TIMEOUT=30000
CRAWLER_USER_AGENT=DeadLinkWatchdog/1.0 (+https://deadlinkwatchdog.com)
MAX_CONCURRENT_CRAWLS=5
MAX_ACTIVE_CRAWL_JOBS_PER_USER=10
MAX_CONCURRENT_CRAWLS_PER_USER=2
USER_CRAWL_EXECUTION_LEASE_MS=120000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Notification Settings
WEBHOOK_TIMEOUT=5000
EMAIL_FROM=noreply@deadlinkwatchdog.com
