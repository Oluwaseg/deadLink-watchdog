{{> shared/header maxWidth="700px"}}
      <div class='header'>Crawl report for {{websiteName}}</div>
      <p>Hi {{firstName}},</p>
      <p>{{statusMessage}}</p>

      <div class='summary'>
        <div class='summary-box'>
          <p><strong>Website:</strong>
            <a href='{{websiteUrl}}'>{{websiteName}}</a></p>
          <p><strong>Crawl date:</strong> {{crawlDate}}</p>
          <p><strong>Total links checked:</strong> {{totalLinksChecked}}</p>
          <p><strong>Broken links found:</strong> {{brokenLinksFound}}</p>
          <p><strong>Health score:</strong> {{healthScore}}%</p>
        </div>
      </div>

      {{#if brokenLinks.length}}
        <div class='broken-links'>
          <h3>Broken links found</h3>
          {{#each brokenLinks}}
            <div class='broken-link'>
              <p><strong>URL:</strong>
                <a href='{{this.url}}'>{{this.url}}</a></p>
              <p><strong>Source:</strong>
                <a href='{{this.sourceUrl}}'>{{this.sourceUrl}}</a></p>
              <p><strong>Error:</strong>
                {{this.errorType}}
                {{#if this.statusCode}}({{this.statusCode}}){{/if}}</p>
              {{#if this.errorMessage}}<p><strong>Message:</strong>
                  {{this.errorMessage}}</p>{{/if}}
            </div>
          {{/each}}
        </div>
      {{/if}}

{{> shared/footer closing="Thanks," footerNote="Visit your dashboard to review the full crawl details and manage your website notifications."}}