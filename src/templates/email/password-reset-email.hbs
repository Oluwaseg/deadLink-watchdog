{{> shared/header maxWidth="600px"}}
      <div class='header'>Reset your password</div>
      <p>Hi {{firstName}},</p>
      <p>We received a request to reset your password for
        {{appName}}. Click the button below to set a new password:</p>
      <p><a class='button' href='{{resetUrl}}'>Reset Password</a></p>
      <p>If the button does not work, copy and paste this link into your
        browser:</p>
      <p><a href='{{resetUrl}}'>{{resetUrl}}</a></p>
      <p>This link expires in
        {{expiryHours}}
        hour{{#unless expiryHours}}s{{/unless}}.</p>
      <p>If you did not request a password reset, please ignore this email.</p>
{{> shared/footer closing="Thanks,"}}