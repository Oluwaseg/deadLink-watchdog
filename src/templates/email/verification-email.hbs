{{> shared/header maxWidth="600px"}}
      <div class='header'>Verify your email</div>
      <p>Hi {{firstName}},</p>
      <p>Thank you for signing up for
        {{appName}}. Use the code below to verify your email address:</p>
      <p
        style='font-size: 22px; font-weight: 700; letter-spacing: 0.1em;'
      >{{verificationCode}}</p>
      <p>This code is valid for {{expiryHours}} hours.</p>
      <p>If you did not request this, you can safely ignore this email.</p>
{{> shared/footer closing="Thanks,"}}