{
  "name": "deadlink-watchdog",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "API that monitors broken links in Nigerian websites",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "setup": "node start.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:drop-tables": "node scripts/drop-tables.js",
    "seed:admin": "prisma migrate deploy && node scripts/seed-admin.js",
    "test": "node test-setup.js",
    "test:unit": "node --test --test-concurrency=1 tests/admin-users.test.js tests/config-validation.test.js tests/crawl-budget.test.js tests/crawl-processor-recovery.test.js tests/crawl-queue-limits.test.js tests/crawl-retry.test.js tests/email-verification.test.js tests/outbound-proxy.test.js tests/outbound-url-policy.test.js tests/realtime.test.js tests/website-limit.test.js",
    "test:integration:postgres": "node scripts/run-postgres-integration.js",
    "test:integration:redis": "node scripts/run-redis-integration.js",
    "test:integration:chromium": "node --test tests/outbound-chromium.integration.test.js",
    "test:realtime": "node --test tests/realtime.test.js",
    "test:watch": "nodemon test-setup.js",
    "redis:flush": "redis-cli FLUSHALL"
  },
  "keywords": [
    "link-checker",
    "web-crawler",
    "monitoring",
    "api",
    "nigeria"
  ],
  "author": "DeadLink Watchdog Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "bull": "4.16.5",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.2",
    "handlebars": "4.7.10",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.9",
    "pg": "8.23.1",
    "puppeteer": "25.16.0",
    "redis": "5.12.1",
    "socket.io": "^4.8.4",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4"
  },
  "packageManager": "pnpm@12.15.0"
}
